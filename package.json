{
  "name": "json-examples-validator",
  "version": "0.1.0",
  "description": "Validate the *.json-examples.json files of a JSON Schema library against its schemas (ajv + ajv-formats), optionally as vitest tests",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./vitest": { "types": "./dist/vitest.d.ts", "default": "./dist/vitest.js" }
  },
  "bin": { "json-examples-validator": "./dist/cli.js" },
  "files": ["dist"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jsonschema-lib-layout": "file:../jsonschema-lib-layout"
  },
  "peerDependencies": {
    "vitest": ">=1"
  },
  "peerDependenciesMeta": {
    "vitest": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
